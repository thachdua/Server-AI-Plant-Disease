# Copy to .env for local dev (never commit .env)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Backend only. Prefer the service role key on Render/local backend.
# Never put this key in the iOS app.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Postgres (Supabase pooler)
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_db_password
DB_NAME=postgres
DB_PORT=6543

# External APIs
OPENWEATHER_API_KEY=
GEMINI_API_KEY=
# Optional: GEMINI_API_KEYS=key1,key2

# Hugging Face inference Space (public URL)
HF_API_URL=https://your-space.hf.space/predict

# Prediction API protection
# Set true in production if only logged-in app users may scan.
PREDICT_REQUIRE_AUTH=false
PREDICT_MAX_UPLOAD_BYTES=5242880
PREDICT_RATE_LIMIT_PER_MINUTE=20

# Quota protection for public AI/weather endpoints
LLM_RATE_LIMIT_PER_MINUTE=10
LLM_CHAT_MAX_CHARS=4000
WEATHER_RATE_LIMIT_PER_MINUTE=60
